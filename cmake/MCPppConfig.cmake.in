@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(MCPpp_core_FOUND TRUE)
set(MCPpp_beast_FOUND @MCPP_WITH_BEAST@)
set(MCPpp_BEAST_TLS @MCPP_PACKAGE_BEAST_TLS@)
include("${CMAKE_CURRENT_LIST_DIR}/MCPppCoreTargets.cmake")

# A core-only consumer does not need Boost, OpenSSL, a JSON library, or tools.
foreach(component IN LISTS MCPpp_FIND_COMPONENTS)
  if(component STREQUAL "beast" AND MCPpp_beast_FOUND)
    find_dependency(Boost 1.92.0 EXACT CONFIG COMPONENTS beast asio)
    find_dependency(Threads)
    if(MCPpp_BEAST_TLS)
      find_dependency(OpenSSL 3.0)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/MCPppBeastTargets.cmake")
  elseif(NOT component STREQUAL "core")
    set(MCPpp_${component}_FOUND FALSE)
    set(MCPpp_NOT_FOUND_MESSAGE "MCPpp component '${component}' was not installed")
  endif()
endforeach()
check_required_components(MCPpp)
